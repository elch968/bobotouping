<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BoboTouping" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/bg_top</item>
        <item name="colorAccent">@color/brand</item>

        <item name="android:windowBackground">@drawable/bg_screen</item>
