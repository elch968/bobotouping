{
  "name": "bobotouping-desktop",
  "version": "1.3.0",
  "description": "波波投屏 电脑端（接收手机屏幕与声音，并支持反向控制）",
  "main": "src/main/index.js",
  "author": "bobotouping",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/loopback.test.js",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bobo.touping.desktop",
    "productName": "波波投屏",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "波波投屏-电脑端-${version}-安装包.${ext}"
    },
    "portable": {
      "artifactName": "波波投屏-电脑端-${version}-便携版.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "波波投屏",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ]
    }
  }
}
